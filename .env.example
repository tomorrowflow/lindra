# Copy to .env (gitignored). One application token guards every page and
# API route; only /health, the login page and /static/ are open.
# Generate a token with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
LINDRA_TOKEN=

# Optional. Where the service keeps its data; default ./data.
# LINDRA_DATA_DIR=data

# Optional. The time zone of the physician's clock: "now" for a new visit's date.
# Default Europe/Berlin, whatever zone the host runs in.
# LINDRA_TIMEZONE=Europe/Berlin

# Optional. The only backend is the deterministic stand-in `fixture`; any other
# value stops the service at start (ADR 0003). Real backends arrive with a later
# ticket and never run in the throwaway or test tier.
# LINDRA_TEXT_BACKEND=fixture
# LINDRA_SPEECH_BACKEND=fixture

# Stacks started by scripts/env.py get their own env file under .lindra-env/
# and set LINDRA_TIER and LINDRA_COMMIT themselves.
