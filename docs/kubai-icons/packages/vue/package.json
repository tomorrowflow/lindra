{
  "name": "kubai-icons-vue",
  "version": "0.5.1",
  "description": "Kubai Icons as Vue 3 components: tree-shakable, SSR-friendly, animated on hover.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./icons/*": { "types": "./dist/icon-module.d.ts", "default": "./dist/icons/*.js" },
    "./dynamic": { "types": "./dist/dynamic.d.ts", "default": "./dist/dynamic.js" },
    "./package.json": "./package.json"
  },
  "files": ["dist", "LICENSE", "README.md"],
  "peerDependencies": { "vue": ">=3.3" },
  "dependencies": { "kubai-icons": "0.5.1" },
  "keywords": ["icons", "vue", "svg", "animated-icons", "kubai"],
  "homepage": "https://icons.kubai.design/",
  "repository": { "type": "git", "url": "git+https://github.com/kubai087/kubai-icons.git", "directory": "packages/vue" },
  "publishConfig": { "access": "public", "provenance": true }
}
